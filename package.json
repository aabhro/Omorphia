{
  "name": "omorphia",
  "version": "1.4.0",
  "description": "Dependency-free, CDN-first UI components and stylesheet with directional border illumination.",
  "main": "dist/omorphia.min.js",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/gen-icons.mjs && node scripts/build.mjs",
    "test": "npm run build && node tests/utilities.mjs && node tests/smoke.mjs && node tests/advanced-components.mjs && node tests/showcase.mjs && node tests/types.mjs",
    "test:visual": "node tests/visual-regression.mjs",
    "test:types": "tsc --noEmit --strict --lib DOM,ES2022 --moduleResolution bundler --module esnext tests/types.fixture.ts"
  },
  "keywords": [
    "ui",
    "web-components",
    "css",
    "cdn",
    "lucide"
  ],
  "author": "aabhro",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "lucide-static": "^1.77.0"
  },
  "module": "dist/omorphia.esm.min.js",
  "style": "dist/omorphia.min.css",
  "files": [
    "dist",
    "src",
    "types"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabhro/Omorphia.git"
  },
  "types": "types/index.d.ts"
}
